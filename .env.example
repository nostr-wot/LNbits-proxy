# Copy to .env and fill in. Never commit the real file.

# LNbits backend, reachable from this host.
LNBITS_URL=http://127.0.0.1:5000

# LNbits super-user API key. Required: provisioning refuses to run without it.
LNBITS_ADMIN_KEY=

# LNbits SQLite databases. Must be readable and writable by the user this
# service runs as, which is the same user LNbits itself writes them with.
LNBITS_DB_PATH=/home/lnbits/lnbits/data/database.sqlite3
LNURLP_DB_PATH=/home/lnbits/lnbits/data/ext_lnurlp.sqlite3

# Proxy-owned mapping of Nostr pubkey to wallet. Must NOT live inside the LNbits
# database and must not be writable by the LNbits user: LNbits lets any logged-in
# user set accounts.pubkey on their own account, so that column cannot be what
# decides whose wallet is whose. Created automatically, keep it at mode 600.
PROVISION_DB_PATH=/srv/zaps-provision/provisioning.sqlite3

# Trusted HTTPS origin, without a trailing slash; never derived from request headers.
PUBLIC_ORIGIN=https://zaps.nostr-wot.com
# Exact HTTPS browser origins, comma-separated. Empty denies browser-origin v2 calls.
# Native extensions use signed transactions and do not need an entry here.
BROWSER_ORIGINS=

# Loopback port. A reverse proxy terminates TLS in front of this.
PORT=3003

# ── monitor/monitor.mjs ──
# On the host this lives at /srv/zaps-monitor/zaps-monitor.env, mode 600, and is
# loaded by monitor/run-monitor.sh from cron. cron passes no environment of its
# own, and the monitor refuses to run unconfigured rather than alerting on a
# stack it cannot actually see.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
PHOENIX_CONF=/home/phoenixd/.phoenix/phoenix.conf
STATE_FILE=/srv/zaps-monitor/state.json
LOG_FILE=/srv/zaps-monitor/monitor.log

# Public base URL the monitor probes.
MONITOR_BASE_URL=https://zaps.nostr-wot.com
# Lightning Addresses probed for reachability, comma separated.
MONITOR_LNURL_NAMES=robert,leon
# Address used for the end-to-end invoice check. Give this its own wallet: the
# check mints a real invoice on every run.
MONITOR_ADDRESS=robert
MONITOR_INVOICE_EXPIRY=30
# Consecutive failed runs required before alerting. 1 restores immediate alerts.
MONITOR_ALERT_AFTER=2
MONITOR_PYTHON=/usr/bin/python3
MONITOR_CLEANUP=/srv/zaps-monitor/cleanup.py

# Liquidity checks (monitor/liquidity.mjs). The phoenixd API is read with the
# limited-access password from PHOENIX_CONF when it has one, the full one otherwise.
# The LNbits database is opened read-only. RUNBOOK.md, "Inbound liquidity".
LIQUIDITY_CHECKS=1
LNBITS_DB_PATH=/home/lnbits/lnbits/data/database.sqlite3
# Alert when total inbound liquidity is below the higher of these two.
LIQUIDITY_MIN_INBOUND_SAT=200000
LIQUIDITY_DEPOSIT_MULTIPLE=2
LIQUIDITY_DEPOSIT_WINDOW_DAYS=30
# Alert when a channel's capacity falls by at least this much between runs.
LIQUIDITY_CAPACITY_DROP_SAT=100000
LIQUIDITY_REMINDER_HOURS=12
# How far back the first run looks for purchases and charged deposits.
LIQUIDITY_LOOKBACK_HOURS=48
# How close to a purchase a charged deposit must settle to be attributed to it.
LIQUIDITY_MATCH_WINDOW_MINUTES=30

# ── monitor/cleanup.py ──
# Where locks and dated database backups are written.
MONITOR_STATE_DIR=/srv/zaps-monitor
# phoenixd HTTP API, used by cleanup.py and the monitor.
PHOENIX_URL=http://127.0.0.1:9740
# Required only for --retire-monitor. These identify the monitor's own invoice;
# there is no default, because retiring against the wrong wallet would touch a
# real user's payments.
MONITOR_WALLET_ID=
MONITOR_LINK_ID=
