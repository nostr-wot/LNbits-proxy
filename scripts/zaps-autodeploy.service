[Unit]
Description=Deploy the newest published LNbits-proxy release if it is not already live
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The checkout deploy.sh is run from, which is the source of truth; it refuses to
# run from a dirty tree. This is the one thing to change if your checkout is
# somewhere else: both lines must name the same directory, and `systemctl status
# zaps-autodeploy` says so immediately if they do not.
WorkingDirectory=/srv/LNbits-proxy
ExecStart=/srv/LNbits-proxy/scripts/auto-deploy.sh
# deploy.sh installs systemd units and writes under /usr/local/bin, so this needs
# root. It is the same work the operator did by hand, on a timer.
User=root
# One deploy can legitimately take a couple of minutes: npm ci, a migration and a
# verification pass. Past that something is wrong and the old version is still live.
TimeoutStartSec=900
